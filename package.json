{
    "name": "red-sync",
    "version": "0.1.0",
    "description": "Synchronise your vault through a Cloudflare R2 bucket, with optional end-to-end encryption.",
    "main": "main.js",
    "type": "module",
    "scripts": {
        "dev": "node --env-file-if-exists=.env esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "buildDev": "node esbuild.config.mjs dev",
        "lint": "eslint --cache --cache-strategy content --concurrency off src",
        "lint:community": "eslint --config eslint.community.config.mjs --concurrency off src",
        "svelte-check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "tsc-check": "tsc --noEmit",
        "pretty:json": "prettier --config ./.prettierrc.mjs \"**/*.json\" --write --log-level error",
        "pretty": "bun run prettyNoWrite -- --write --log-level error",
        "prettyCheck": "bun run prettyNoWrite -- --check",
        "prettyNoWrite": "prettier --config ./.prettierrc.mjs \"**/*.js\" \"**/*.ts\" \"**/*.json\" ",
        "precheck:compatibility": "bun run build",
        "check:compatibility": "node scripts/check-compatibility.js --file main.js --ios 15",
        "check": "bun run tsc-check && bun run lint && bun run lint:community && bun run svelte-check && bun run check:compatibility",
        "test:unit": "vitest run --config vitest.config.unit.ts",
        "test:integration": "vitest run --config vitest.config.integration.ts",
        "test:unit:coverage": "vitest run --config vitest.config.unit.ts --coverage"
    },
    "keywords": [],
    "author": "Karan Parashar",
    "license": "MIT",
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.808.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@tsconfig/svelte": "^5.0.8",
        "@types/diff-match-patch": "^1.0.36",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^24.10.13",
        "@types/pouchdb": "^6.4.2",
        "@types/pouchdb-core": "^7.0.15",
        "@typescript-eslint/parser": "8.69.0",
        "@vitest/coverage-v8": "^4.1.12",
        "acorn": "^8.16.0",
        "esbuild": "0.28.1",
        "esbuild-plugin-inline-worker": "^0.1.1",
        "esbuild-svelte": "^0.9.4",
        "eslint": "^9.39.3",
        "eslint-plugin-obsidianmd": "^0.5.1",
        "eslint-plugin-svelte": "^3.19.0",
        "globals": "^14.0.0",
        "pouchdb-adapter-memory": "^9.0.0",
        "pouchdb-core": "^9.0.0",
        "prettier": "3.8.1",
        "svelte": "5.56.3",
        "svelte-check": "^4.6.0",
        "svelte-eslint-parser": "^1.8.0",
        "svelte-preprocess": "6.0.5",
        "terser": "^5.39.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.69.0",
        "vite": "^8.1.6",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@smithy/fetch-http-handler": "^5.3.10",
        "@smithy/protocol-http": "^5.3.9",
        "@smithy/querystring-builder": "^4.2.9",
        "@smithy/types": "^4.14.3",
        "@vrtmrz/livesync-commonlib": "0.7.0",
        "@vrtmrz/obsidian-plugin-kit": "0.1.7",
        "@vrtmrz/value-store": "0.1.0",
        "diff-match-patch": "^1.0.5",
        "idb": "^8.0.3",
        "markdown-it": "^14.3.3",
        "obsidian": "^1.13.1",
        "octagonal-wheels": "0.1.57"
    },
    "overrides": {
        "moment": "2.31.0",
        "devalue": "5.9.3",
        "uuid": "11.1.1"
    },
    "trustedDependencies": [
        "esbuild"
    ],
    "packageManager": "bun@1.4.4"
}
